<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:infra="clr-namespace:Infrastructure.Services;assembly=INFR"
             x:Class="RougeTracker.Views.MonthDaysGrid">

    <Grid RowDefinitions="*,Auto">


        <CollectionView
            Grid.Row="0"
        MaximumWidthRequest="600"
        MinimumWidthRequest="100"
        
        ItemsSource="{Binding Days}"
        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout 
                VerticalItemSpacing="5"
                HorizontalItemSpacing="5"
                Orientation="Vertical"
                Span="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="infra:MonthInfo">

                    <Border HeightRequest="60"
                        Style="{StaticResource Chip}" 
                        Padding="10,6">

                        <VerticalStackLayout>

                            <Label Text="{Binding Day}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                            <Entry Text="{Binding Gross}"
                               HorizontalTextAlignment="Center"
                               IsReadOnly="False"
                               />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Grid.Row="1"
                Text="Save"
                Margin="10"/>
    </Grid>

</ContentPage>