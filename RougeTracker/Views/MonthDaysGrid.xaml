<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RougeTracker.Models"
             xmlns:controls="clr-namespace:RougeTracker.Controls"
             x:Class="RougeTracker.Views.MonthDaysGrid">

    <Grid RowDefinitions="*,Auto">

        <!-- Days grid -->
        <CollectionView
            x:Name="DaysCollection"
            Grid.Row="0"
            VerticalOptions="Fill"
            MinimumWidthRequest="500"
            ItemsSource="{Binding Days}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout 
                    x:Name="DaysLayout"
                    VerticalItemSpacing="5"
                    HorizontalItemSpacing="5"
                    Orientation="Vertical"
                    Span="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DayInfoObservable">

                    <Border 
                        Style="{StaticResource Chip}" 
                        Padding="10,6"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CellHeight}"
                        WidthRequest="-1"
                        >

                        <VerticalStackLayout>

                            <Label Text="{Binding Day}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                            <controls:NumericEntry
                                Value="{Binding Gross, Mode=TwoWay}"
                                Placeholder="0"
                                TextColor="{Binding Gross, Converter={StaticResource NumberToIncomeColorConverter}}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Grid.Row="1"
                Command="{Binding SaveCommand}"
                Text="Save"
                Margin="10"/>
    </Grid>

</ContentPage>