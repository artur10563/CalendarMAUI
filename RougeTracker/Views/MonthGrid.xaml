<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RougeTracker.Models"
             x:Class="RougeTracker.Views.MonthGrid"
             Title="">

    <Grid Padding="12"
          RowDefinitions="Auto,Auto"
          RowSpacing="16">

        <!-- YEARS -->
        <CollectionView 
            HorizontalOptions="Center"
            Grid.Row="0"
            ItemsSource="{Binding Years}"
            SelectedItem="{Binding SelectedYear}"
            SelectionMode="Single">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="6"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                    <Border Style="{StaticResource Chip}">
                        <Label Text="{Binding .}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- MONTHS -->
        <CollectionView 
            x:Name="MonthCollection"
            ItemsSource="{Binding Months}"
            SelectedItem="{Binding SelectedMonth}"
            SelectionChangedCommand="{Binding OpenMonthCommand}"
            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
            MinimumWidthRequest="100"
            Grid.Row="1"
            SelectionMode="Single"
            VerticalOptions="Fill"
            HorizontalOptions="Fill">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="4"
                    HorizontalItemSpacing="6"
                    VerticalItemSpacing="6"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MonthInfoObservable">
                    <Border Style="{StaticResource Chip}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            WidthRequest="-1"
                            HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CellHeight}"
                            Padding="10,6">
                        <Grid RowDefinitions="Auto,*,*">

                            <!-- TOP -->
                            <Label Text="{Binding MonthName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"/>

                            <!-- CENTER BLOCK -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Grid.RowSpan="2"
                                                 Spacing="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Gross, Converter={StaticResource SignedNumberConverter}}"
                                       TextColor="{Binding  Gross, Converter={StaticResource NumberToIncomeColorConverter}}"
                                       FontSize="16"
                                       HorizontalOptions="Center"/>
                             
                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>